@startuml

' =========================
' Acteurs / externes
' =========================
actor "Opérateur" as OP
component "Arrivée des ordres\n(externe)" as EXT <<external>>

' =========================
' COMPOSANT 2 : Poste Opérateur (N occurrences)
' =========================
package "POSTE OPÉRATEUR\n(COMPOSANT 2) Occurrence=N" as POSTE {
  component "Liste des ordres" as LISTE
  component "Observer\n(distant)" as OBS
  component "Critères" as CRIT
}

OBS --> LISTE : maj

' =========================
' COMPOSANT 1 : Serveur principal
' =========================
package "SERVEUR PRINCIPAL\n(COMPOSANT 1)" as SP {
  component "Factory des Ordres" as FACTORY
  component "Ordre" as ORDRE
  component "Observable\n(distant)" as OBSV
}

FACTORY --> ORDRE : création
ORDRE --> OBSV : notifier

' =========================
' COMPOSANT 1 bis : Serveur secondaire
' =========================
package "SERVEUR SECONDAIRE\n(COMPOSANT 1 bis)" as SS {
  component "Factory des Ordres" as FACTORY2
  component "Ordre" as ORDRE2
}

FACTORY2 --> ORDRE2 : création

' =========================
' COMPOSANT 4 : Agence bancaire
' =========================
package "AGENCE BANCAIRE\n(COMPOSANT 4)" as AB

' =========================
' Flux / relations
' =========================

' Arrivée des ordres extérieurs
EXT --> SP : créations ordres

' Opérateur → Poste
OP --> POSTE : Accepter / Refuser /\nAbandonner un ordre

' Poste → Serveur principal
POSTE --> SP : s'abonner
POSTE --> FACTORY : obtenir les ordres\nen f° des critères
POSTE --> ORDRE : maj ordre\nverrouiller un ordre\ndéverrouiller un ordre

' Serveur principal → Poste (notification Observer/Observable)
OBSV --> OBS : ordre\n(notification)

' Serveur secondaire → Serveur principal
SS --> SP : se déclarer

' Serveur principal → Serveur secondaire
FACTORY --> FACTORY2 : créations ordres
ORDRE --> ORDRE2 : maj ordre\nverrouiller un ordre\ndéverrouiller un ordre

' Poste → Agence bancaire
POSTE --> AB : Demande d'informations\nd'un client

@enduml
