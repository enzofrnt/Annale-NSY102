@startuml
left to right direction
skinparam classAttributeIconSize 0

' =========================
' COMPOSANT 1 - Serveur Principal
' =========================

' =========================
' Remote / URO
' =========================
interface Remote
class URO

' =========================
' Factory des Ordres (distant par héritage)
' =========================
interface FactoryOrdres {
  +creerOrdre(OrdreInt o) : OrdreODInt
  +sabonner(ObserverPosteODInt o)
  +getOrdres(Criteres c) : List<OrdreODInt>
  +sedeclarer(FactoryOrdres f)
}
FactoryOrdres --|> Remote

class FactoryOrdresImp {
}
FactoryOrdresImp --|> URO
FactoryOrdresImp ..|> FactoryOrdres

' FactoryOrdresImp connaît l'observable
FactoryOrdresImp *-- ObservablePoste : observable

' FactoryOrdresImp crée les ObserverPoste lors de chaque sabonner()
FactoryOrdresImp "*" --> ObserverPoste : création

' FactoryOrdresImp connaît le factory du serveur secondaire
FactoryOrdresImp o-- FactoryOrdres : factorySecondaire

' =========================
' Observer / Observable
' =========================
interface Observable

interface Observer {
  +update(Object o)
}
Observable "*" o-- Observer

class ObservablePoste
ObservablePoste --|> Observable

class ObserverPoste
ObserverPoste ..|> Observer

' ObserverPoste utilise l'interface distante du poste pour notifier
ObserverPoste o-- ObserverPosteODInt : observerDistant

interface ObserverPosteODInt {
  +update(Object o)
}
ObserverPosteODInt --|> Remote

' =========================
' Interface distante des Ordres
' =========================
interface OrdreODInt {
  +majOrdre(OrdreInt o)
  +verouillerOrdre() : boolean
  +deverouillerOrdre()
  +getteurs()
  +setteurs()
}
OrdreODInt --|> Remote

' =========================
' Interface locale des Ordres
' =========================
interface OrdreInt {
  +majOrdre(OrdreInt o)
  +verouillerOrdre() : boolean
  +deverouillerOrdre()
  +getteurs()
  +setteurs()
}

' =========================
' OrdreOD : Adaptateur pour rendre Ordre distant
' =========================
class OrdreOD
OrdreOD --|> URO
OrdreOD ..|> OrdreODInt

' OrdreOD adapte un Ordre local via l'interface OrdreInt
OrdreOD o-- OrdreInt : ordre

' OrdreOD connaît l'ordre équivalent sur le serveur secondaire
' OrdreOD o-- OrdreODInt : ordreDistantServeurSecondaire

' =========================
' Ordre (abstract) et ses sous-types
' =========================
abstract class Ordre
Ordre o-- OrdreODInt : ordreDistantServeurSecondaire
Ordre ..|> OrdreInt
Ordre o-- ObservablePoste : observable

class Vente
class Achat
class Regroupement

Vente --|> Ordre
Achat --|> Ordre
Regroupement --|> Ordre

OrdreInt --* "*" FactoryOrdresImp : ordres

@enduml
